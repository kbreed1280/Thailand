<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (privacy strings live in the build settings). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>grab</string>
		<string>bolt</string>
	</array>
	<!-- Only standard HTTPS encryption: skips the export-compliance question on every TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Lets iOS open this app when a trip invitation link is tapped. -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- Silent pushes from CloudKit when your travel partner changes the trip. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
